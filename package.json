{
  "name": "refcheck",
  "version": "1.0.0",
  "description": "Reference Sign Checker — validate reference-sign consistency in patent applications",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p jsconfig.json",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "budget": "node build/budget.js dist"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "jsdom": "^29.1.1",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
